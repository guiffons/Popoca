# Popoca Streaming Configuration
PORT=3000
NODE_ENV=development
DISABLE_HMR=false

# Diretório para armazenamento persistente do SQLite (ex: /var/data no Render com Persistent Disk)
DATA_DIR=/var/data

# Limite máximo de torrent engines simultâneos em memória
MAX_ACTIVE_TORRENTS=5

# Origens permitidas para CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Chave secreta para tokens e sessões
JWT_SECRET=sua_chave_secreta_aqui_com_no_minimo_32_caracteres

# URL base da API do backend para deploy desacoplado no Vercel (ex: https://popoca-streaming.onrender.com)
VITE_API_URL=
